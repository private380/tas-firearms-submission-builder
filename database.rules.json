{
  "rules": {
    "communityParticipation": {
      "generatedSubmissions": {
        ".read": true,
        ".write": "auth != null && newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)",
        ".validate": "newData.val() >= 0"
      }
    },
    "communityResults": {
      ".read": true,
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['recordedSubmissions', 'amendments', 'furtherSuggestions', 'closingSuggestions']) && newData.child('recordedSubmissions').isNumber() && newData.child('recordedSubmissions').val() === (data.child('recordedSubmissions').exists() ? data.child('recordedSubmissions').val() + 1 : 1)"
    }
  }
}